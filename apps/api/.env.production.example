APP_ENV=production
PORT=8000
# Comma separated. Add your web and landing domains.
# Keep "null" if you ship the desktop app: a packaged Electron app loads from file:// and
# sends "Origin: null". Remove it if you do not ship the desktop app.
CORS_ORIGINS=https://your-web-domain.example,https://your-landing-domain.example,null
DATABASE_PATH=/data/app.db
